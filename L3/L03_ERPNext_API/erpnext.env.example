# Skopiuj ten plik jako erpnext.env i uzupełnij wartości.
# NIE umieszczaj pliku erpnext.env w raporcie ani w paczce do oddania.
BASE_URL=https://twoja-instancja-erpnext.example
API_KEY=WPISZ_API_KEY
API_SECRET=WPISZ_API_SECRET

# Unikalny prefiks zespołu na wspólnej instancji, np. A1, A2, B1.
# Zostaw pusty tylko wtedy, gdy każdy zespół ma osobną witrynę ERPNext.
LAB_PREFIX=A1

# Poniższe wartości muszą istnieć w Twojej instancji ERPNext.
COMPANY=Laboratorium ERP sp. z o.o.
CURRENCY=PLN
SELLING_PRICE_LIST=Standard Selling
CUSTOMER_GROUP=Commercial
TERRITORY=Poland
ITEM_GROUP=Services
STOCK_UOM=Nos
SALES_ORDER_NAMING_SERIES=SAL-ORD-.YYYY.-
PRINT_FORMAT=Standard
EXPORT_FROM_DATE=2026-10-16
VERIFY_TLS=true
